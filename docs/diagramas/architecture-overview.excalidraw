      "isDeleted": false,
      "boundElements": [],
      "updated": 1791510522710,
      "created": 1791510463191,
      "link": null,
      "locked": false,
      "text": "O servidor é agnostico a cliente, a persistencia no BANCO aceitará a\nsolicitação que tem a EVENT DATE (DO FRONT-END) mais recente, não o\nevento a pingar no backend de forma mais recente.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O servidor é agnostico a cliente, a persistencia no BANCO aceitará a solicitação que tem a EVENT DATE (DO FRONT-END) mais recente, não o evento a pingar no backend de forma mais recente.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
